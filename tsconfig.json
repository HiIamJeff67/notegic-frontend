{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "typeRoots": ["./node_modules/@types", "./types"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@assets/*": ["./apps/web/assets/*"],
      "@shared/api/*": ["./packages/api/*"],
      "@shared/components/*": ["./packages/ui/*"],
      "@shared/hooks/*": ["./packages/hooks/*"],
      "@shared/i18n": ["./packages/i18n/index.ts"],
      "@shared/i18n/*": ["./packages/i18n/*"],
      "@shared/lib/*": ["./packages/lib/*"],
      "@shared/reducers/*": ["./packages/lib/reducers/*"],
      "@shared/styles/*": ["./packages/ui/styles/*"],
      "@shared/types/*": ["./packages/lib/types/*"],
      "@widgets/*": ["./apps/web/src/components/widgets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx"
  ],
  "exclude": ["node_modules", "apps/desktop"]
}
