{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "typeRoots": ["./node_modules/@types", "./types"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@assets/*": ["./apps/web/assets/*"],
      "@shared/*": ["./shared/*"],
      "@widgets/*": ["./apps/web/src/components/widgets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "test/**/*.ts",
    "codegen.ts"
  ],
  "exclude": ["node_modules"]
}
