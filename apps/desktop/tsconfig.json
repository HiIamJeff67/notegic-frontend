{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../web/src/*"],
      "@assets/*": ["../web/assets/*"],
      "@widgets/*": ["./src/components/widgets/*"],
      "@shared/api/*": ["../../packages/api/*"],
      "@shared/components/*": ["../../packages/ui/*"],
      "@shared/hooks/*": ["../../packages/hooks/*"],
      "@shared/i18n": ["../../packages/i18n/index.ts"],
      "@shared/i18n/*": ["../../packages/i18n/*"],
      "@shared/lib/*": ["../../packages/lib/*"],
      "@shared/reducers/*": ["../../packages/lib/reducers/*"],
      "@shared/styles/*": ["../../packages/ui/styles/*"],
      "@shared/types/*": ["../../packages/lib/types/*"]
    }
  },
  "include": ["src", "test"]
}
