{
  "name": "notegic-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "npm@10.8.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@notegic/web",
    "build": "turbo run build --filter=@notegic/web",
    "build:web": "turbo run build --filter=@notegic/web",
    "build:web:cloudflare": "NITRO_PRESET=cloudflare_module turbo run build --filter=@notegic/web",
    "deploy:web:cloudflare": "npm run build:web:cloudflare && npx wrangler@4.126.0 deploy --config apps/web/.output/server/wrangler.json",
    "start": "turbo run start --filter=@notegic/web",
    "typecheck": "turbo run typecheck --filter=@notegic/web",
    "format:all": "biome format apps shared test scripts codegen.ts package.json tsconfig.json biome.json turbo.json apps/web/tsconfig.json apps/web/vite.config.ts --write",
    "format:check": "biome format apps shared test scripts codegen.ts package.json tsconfig.json biome.json turbo.json apps/web/tsconfig.json apps/web/vite.config.ts",
    "lint": "biome lint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "generate-local-migrations": "npx drizzle-kit generate --config apps/web/src/api/local/drizzle.config.ts",
    "clear-local-migrations": "rm -rf apps/web/src/api/local/migrations/**",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "codegen:check": "npm run codegen && git diff --exit-code -- shared/api/graphql/generated && test -z \"$(git ls-files --others --exclude-standard -- shared/api/graphql/generated)\"",
    "devlog": "node scripts/devlog.mjs",
    "devlog:help": "node scripts/devlog.mjs --help",
    "devlog:fetch": "git fetch origin --prune",
    "devlog:backfill": "node scripts/devlog.mjs --backfill --ref origin/main",
    "install-hooks": "git config core.hooksPath .githooks",
    "generate:public-api": "node scripts/generatePublicApiData.mjs",
    "generate:public-api:help": "node scripts/generatePublicApiData.mjs --help",
    "recodegen:mac": "npm run codegen",
    "recodegen:win": "npm run codegen",
    "licenses:json": "mkdir -p LICENSES && npx license-checker-rseidelsohn --production --json --relativeLicensePath --out LICENSES/third_party_licenses.json",
    "licenses:csv": "mkdir -p LICENSES && npx license-checker-rseidelsohn --production --csv --out LICENSES/third_party_licenses.csv",
    "licenses:json:exclude": "mkdir -p LICENSES && npx license-checker-rseidelsohn --production --json --excludePackages '@notegic/ui;@notegic/core' --out LICENSES/third_party_licenses.json",
    "licenses:collect": "node scripts/getThirdPartyLicenses.mjs",
    "licenses:all": "npm run licenses:json && npm run licenses:collect"
  },
  "dependencies": {
    "@apollo/client": "^4.0.2",
    "@apollo/client-integration-tanstack-start": "^0.14.5-rc.0",
    "@blocknote/core": "^0.54.0",
    "@blocknote/diagram-block": "^0.54.0",
    "@blocknote/math-block": "^0.54.0",
    "@blocknote/react": "^0.54.0",
    "@blocknote/shadcn": "^0.54.0",
    "@blocknote/xl-docx-exporter": "^0.54.0",
    "@blocknote/xl-pdf-exporter": "^0.54.0",
    "@hookform/resolvers": "^5.2.1",
    "@msgpack/msgpack": "^3.1.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-pdf/math": "^2.0.1",
    "@react-pdf/renderer": "^4.3.1",
    "@react-three/drei": "^10.1.2",
    "@react-three/fiber": "^9.1.2",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-query-devtools": "^5.85.5",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-cli": "^1.166.37",
    "@tanstack/router-core": "1.169.1",
    "@types/lodash": "^4.17.20",
    "@types/three": "^0.177.0",
    "@unpic/react": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "colorthief": "^3.3.1",
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "dompurify": "^3.3.3",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.11.0",
    "http-status-codes": "^2.3.0",
    "i18next": "^26.3.6",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.18.0",
    "marked": "^17.0.6",
    "masonic": "^4.1.0",
    "mathjax-full": "^3.2.2",
    "mathml2omml": "^0.5.0",
    "nitro": "^3.0.260415-beta",
    "pdf-annotate.js": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.8.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^17.0.11",
    "react-resizable-panels": "^3.0.6",
    "rxjs": "^7.8.2",
    "sqlocal": "^0.17.0",
    "tailwind-merge": "^3.3.0",
    "three": "^0.177.0",
    "vite": "^8.0.10",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@types/dompurify": "^3.0.5",
    "@types/estree": "^1.0.8",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/marked": "^5.0.2",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.0.5",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.21.0",
    "turbo": "^2.10.12",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "worker-loader": "^3.0.8"
  }
}
