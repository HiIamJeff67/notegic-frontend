{
  "languages": {
    "TypeScript": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TSX": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JavaScript": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JSX": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JSON": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "JSONC": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "GraphQL": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "CSS": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "HTML": {
      "tab_size": 2,
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on"
    },
    "Markdown": {
      "soft_wrap": "prefer_line",
      "preferred_line_length": 100
    },
    "YAML": {
      "tab_size": 2,
      "format_on_save": "on"
    },
    "TOML": {
      "tab_size": 2,
      "format_on_save": "on"
    }
  },
  "relative_line_numbers": true,
  "lsp": {
    "biome": {
      "binary": {
        "path": "./node_modules/.bin/biome",
        "arguments": ["lsp-proxy"]
      }
    },
    "codebook": {
      "initialization_options": {
        "configPath": ".zed/codebook.toml"
      }
    }
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": true,
    "show_other_hints": false
  }
}
