      "\tExceptionSubDomainCodeShiftAmount,",
      "\tNotezyException",
      "} from \"@shared/api/exceptions\";",
      "import { StatusCodes } from \"http-status-codes\";",
      "",
      "const ${1:_DomainName_}ExceptionDomainCode: ExceptionCode = ${2:_SubDomainCode_};",
      "const ExceptionBaseCode_${1:_DomainName_}: ExceptionCode = ${1:_DomainName_}ExceptionDomainCode * ExceptionSubDomainCodeShiftAmount;",
      "const ExceptionPrefix_${1:_DomainName_}: ExceptionPrefix = \"${1:_DomainName_}\";",
      "",
      "export class ${1:_DomainName_}Exceptions {",
