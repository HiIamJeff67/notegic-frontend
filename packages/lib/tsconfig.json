{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@shared/api/*": ["../api/*"],
      "@shared/lib/*": ["./*"],
      "@shared/reducers/*": ["./reducers/*"],
      "@shared/types/*": ["./types/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "blockpack/specs"
  ]
}
